@model List<ProductMVC.Models.Product>

<h1>Products</h1>

<a asp-controller="Product"
   asp-action="Add"
   class="btn btn-success mb-3">
    Add New Product
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price</td>

                <td>
                    <img src="@product.ImageUrl"
                         width="100"
                         height="100"
                         alt="@product.Name" />
                </td>

                <td>
                    <a asp-controller="Product"
                       asp-action="GetById"
                       asp-route-id="@product.Id"
                       class="btn btn-primary">
                        Show Details
                    </a>

                    <a asp-controller="Product"
                       asp-action="Update"
                       asp-route-id="@product.Id"
                       class="btn btn-warning">
                        Update
                    </a>

                    <a asp-controller="Product"
                       asp-action="Delete"
                       asp-route-id="@product.Id"
                       class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>